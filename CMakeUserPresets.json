        "LD_LIBRARY_PATH": "${sourceDir}/build/${presetName}${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{TURBOWASM_TRIPLET}/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}",
