{
  "version": 6,
  "configurePresets": [
    {
      "name": "vcpkg-cache-ci",
      "hidden": true,
      "inherits": "vcpkg-cache",
      "environment": {
        "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{VCPKG_CACHE_REPOSITORY_ROOT}",
        "VCPKG_BINARY_SOURCES": "$penv{VCPKG_BINARY_SOURCES}"
      }
    },
    {
      "name": "vcpkg-cache-linux",
      "hidden": true,
      "inherits": "vcpkg-cache",
      "cacheVariables": {
        "VCPKG_HOST_TRIPLET": "x64-linux"
      },
      "environment": {
        "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{HOME}/.cache/qigao/vcpkg-cache"
      }
    },
    {
      "name": "vcpkg-cache-windows",
      "hidden": true,
      "inherits": "vcpkg-cache",
      "cacheVariables": {
        "VCPKG_HOST_TRIPLET": "x64-windows"
      },
      "environment": {
        "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{LOCALAPPDATA}/qigao/vcpkg-cache",
        "RE2C_ROOT": "$env{PKG_ROOT}/re2c/windows-x64"
      }
    },
    {
      "name": "native-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "VCPKG_MANIFEST_MODE": true
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_C_FLAGS": "/utf-8",
        "CMAKE_CXX_FLAGS": "/utf-8"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "android",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Android",
        "VCPKG_TARGET_TRIPLET": "arm64-android",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-26",
        "ANDROID_STL": "c++_shared",
        "TURBOWASM_BUILD_TESTS": false,
        "TURBOWASM_BUILD_TOOLS": false,
        "TURBOWASM_ENABLE_CFLOW_ADAPTER": false,
        "TURBOWASM_ENABLE_NATIVE_IO_ADAPTER": false,
        "TURBOWASM_ENABLE_WASI_THREADS_ADAPTER": false,
        "TURBOWASM_ENABLE_WASI_NATIVE_IO_ADAPTER": false
      }
    },
    {
      "name": "sdk-options",
      "hidden": true,
      "cacheVariables": {
        "TURBOWASM_BUILD_TESTS": false,
        "TURBOWASM_BUILD_TOOLS": false,
        "TURBOWASM_ENABLE_COMPONENT": true,
        "TURBOWASM_ENABLE_MIR_JIT": false,
        "TURBOWASM_ENABLE_WASI02_ADAPTER": false,
        "TURBOWASM_ENABLE_WASI02_CNET_ADAPTER": false,
        "TURBOWASM_ENABLE_CFLOW_ADAPTER": false,
        "TURBOWASM_ENABLE_NATIVE_IO_ADAPTER": false,
        "TURBOWASM_ENABLE_WASI_ADAPTER": false,
        "TURBOWASM_ENABLE_WASI_THREADS_ADAPTER": false,
        "TURBOWASM_ENABLE_WASI_NATIVE_IO_ADAPTER": false,
        "TURBOWASM_ENABLE_WASI_HOST_FS_ADAPTER": false,
        "TURBOWASM_ENABLE_WASI_LITTLEFS_ADAPTER": false
      }
