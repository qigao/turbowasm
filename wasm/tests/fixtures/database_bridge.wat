;; Core database ABI fixture; no guest libc dependency.
(module
  (import "turbodb:db" "submit" (func $submit (param i32 i64 i64 i64) (result i32 i64)))
  (import "turbodb:db" "poll" (func $poll (param i64) (result i32 i32)))
  (import "turbodb:db" "await" (func $await (param i64) (result i32 i32)))
  (import "turbodb:db" "receipt" (func $receipt (param i64) (result i32 i32 i64)))
  (import "turbodb:db" "read" (func $read (param i64 i64 i64 i64) (result i32 i64)))
  (import "turbodb:db" "take_resource" (func $take_resource (param i64) (result i32 i64)))
  (import "turbodb:db" "cancel" (func $cancel (param i64) (result i32)))
  (import "turbodb:db" "drop" (func $drop (param i64) (result i32)))
  (memory (export "memory") 1 1)
  (func (export "submit") (param i32 i64 i64 i64) (result i32 i64) local.get 0 local.get 1 local.get 2 local.get 3 call $submit)
  (func (export "poll") (param i64) (result i32 i32) local.get 0 call $poll)
  (func (export "await") (param i64) (result i32 i32) local.get 0 call $await)
  (func (export "receipt") (param i64) (result i32 i32 i64) local.get 0 call $receipt)
  (func (export "read") (param i64 i64 i64 i64) (result i32 i64) local.get 0 local.get 1 local.get 2 local.get 3 call $read)
  (func (export "take_resource") (param i64) (result i32 i64) local.get 0 call $take_resource)
  (func (export "cancel") (param i64) (result i32) local.get 0 call $cancel)
  (func (export "drop") (param i64) (result i32) local.get 0 call $drop)
  (func (export "put") (param i32 i32) local.get 0 local.get 1 i32.store8)
  (func (export "get") (param i32) (result i32) local.get 0 i32.load8_u)
)
