{
  "targets": {
    "turbowasm_conformance_driver": {
      "kind": "header_only",
      "test": {
        "tool": "python",
        "args": ["$moduledir/test_run_core.py"],
        "labels": ["conformance"]
      }
    },
    "turbowasm_spec_runner": {
      "kind": "executable",
      "testOnly": true,
      "when": {
        "config": ["conformance", "core3"]
      },
      "sources": {
        "files": ["spec_runner.c"]
      },
      "private": {
        "includeDirs": ["../../src"],
        "deps": ["turbowasm", "saltsbase_core"]
      }
    },
    "turbowasm_spec_runner_mir": {
      "kind": "executable",
      "testOnly": true,
      "when": {
        "config": ["conformance", "core3"]
      },
      "sources": {
        "files": ["spec_runner.c"]
      },
      "private": {
        "includeDirs": ["../../src"],
        "deps": ["turbowasm", "saltsbase_core", "turbowasm_mir_backend"],
        "defines": {
          "TURBOWASM_SPEC_ENABLE_MIR": "1"
        }
      }
    },
    "turbowasm_conformance_harness": {
      "kind": "header_only",
      "when": {
        "config": "conformance"
      },
      "runtimeDeps": ["turbowasm_spec_runner"],
      "test": {
        "tool": "python",
        "args": [
          "$moduledir/run_core.py",
          "--runner",
          "${artifact:turbowasm_spec_runner}",
          "--wast2json",
          "${envPath:TURBOWASM_WABT_ROOT}/bin/wast2json${host:exe}",
          "--core-dir",
          "$moduledir",
          "--suite",
          "$moduledir/result-set-harness-smoke.txt"
        ],
        "labels": ["conformance"]
      }
    },
    "turbowasm_conformance_core": {
      "kind": "header_only",
      "when": {
        "config": "conformance"
      },
      "runtimeDeps": ["turbowasm_spec_runner"],
      "test": {
        "tool": "python",
        "args": [
          "$moduledir/run_core.py",
          "--runner",
          "${artifact:turbowasm_spec_runner}",
          "--wast2json",
          "${envPath:TURBOWASM_WABT_ROOT}/bin/wast2json${host:exe}",
          "--core-dir",
          "${envPath:TURBOWASM_SPEC_ROOT}/test/core",
          "--suite",
          "$moduledir/core-smoke.txt"
        ],
        "labels": ["conformance"]
      }
    },
    "turbowasm_conformance_mir": {
      "kind": "header_only",
      "when": {
        "config": "conformance"
      },
      "runtimeDeps": ["turbowasm_spec_runner", "turbowasm_spec_runner_mir"],
      "test": {
        "tool": "python",
        "args": [
          "$moduledir/run_core.py",
          "--runner",
          "${artifact:turbowasm_spec_runner}",
          "--wast2json",
          "${envPath:TURBOWASM_WABT_ROOT}/bin/wast2json${host:exe}",
          "--core-dir",
          "${envPath:TURBOWASM_SPEC_ROOT}/test/core",
          "--suite",
          "$moduledir/core-smoke.txt",
          "--compare-runner",
          "${artifact:turbowasm_spec_runner_mir}",
          "--require-mir",
          "--reject-runtime-unsupported"
        ],
        "labels": ["conformance"]
      }
    },
    "turbowasm_conformance_core3": {
      "kind": "header_only",
      "when": {
        "config": "core3"
      },
      "runtimeDeps": ["turbowasm_spec_runner"],
      "test": {
        "tool": "python",
        "args": [
          "$moduledir/run_core.py",
          "--runner",
          "${artifact:turbowasm_spec_runner}",
          "--wasm-tools",
          "${envPath:TURBOWASM_CORE3_TOOLS}",
          "--core-dir",
          "${envPath:TURBOWASM_SPEC_ROOT}/test/core",
          "--all-core",
          "--maximum-unsupported",
          "0"
        ],
        "timeout": 600,
        "labels": ["conformance"]
      }
    },
    "turbowasm_conformance_core3_references": {
      "kind": "header_only",
      "when": {
        "config": "core3"
      },
      "runtimeDeps": ["turbowasm_spec_runner"],
      "test": {
        "tool": "python",
        "args": [
          "$moduledir/run_core.py",
          "--runner",
          "${artifact:turbowasm_spec_runner}",
          "--wasm-tools",
          "${envPath:TURBOWASM_CORE3_TOOLS}",
          "--core-dir",
          "${envPath:TURBOWASM_SPEC_ROOT}/test/core",
          "--suite",
          "$moduledir/core3-reference-regression.txt",
          "--maximum-unsupported",
          "0"
        ],
        "timeout": 180,
        "labels": ["conformance"]
      }
    },
    "turbowasm_conformance_core3-mir": {
      "kind": "header_only",
      "when": {
        "config": "core3"
      },
      "runtimeDeps": ["turbowasm_spec_runner", "turbowasm_spec_runner_mir"],
