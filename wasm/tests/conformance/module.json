          "$moduledir/run_core.py",
          "--runner",
          "${artifact:turbowasm_spec_runner}",
          "--wasm-tools",
          "${envPath:TURBOWASM_CORE3_TOOLS}",
          "--core-dir",
          "${envPath:TURBOWASM_SPEC_ROOT}/test/core",
          "--all-core",
          "--maximum-unsupported",
          "0",
          "--compare-runner",
          "${artifact:turbowasm_spec_runner_mir}",
          "--require-mir"
        ],
        "timeout": 600,
        "labels": ["conformance"]
      }
    },
    "turbowasm_conformance_exception-handling": {
      "kind": "header_only",
      "when": {
        "config": "conformance"
      },
      "runtimeDeps": ["turbowasm_spec_runner"],
      "test": {
        "tool": "python",
        "args": [
          "$moduledir/run_proposal.py",
          "--selector",
          "exception-handling",
          "--wast2json",
          "${envPath:TURBOWASM_WABT_ROOT}/bin/wast2json${host:exe}",
          "--runner",
          "${artifact:turbowasm_spec_runner}",
          "--reject-runtime-unsupported"
