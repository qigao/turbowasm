set(CMAKE_COLOR_DIAGNOSTICS ON)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)

# building the tests
option(BUILD_TESTS "Enable the tests" OFF)

option(ENABLE_GIT_INFO "List git status" OFF)
option(ENABLE_SAMPLES "Enable sample projects" ON)
set_property(GLOBAL PROPERTY USE_FOLDERS ON)


option(ENABLE_ASAN "Enable AddressSanitizer" OFF)
option(ENABLE_UBSAN "Enable UndefinedBehaviorSanitizer" OFF)
option(ENABLE_TSAN "Enable ThreadSanitizer" OFF)

# Core modules follow the split SDK graph; the preset controls the test suite.
set(TURBOWASM_BUILD_TESTS ${BUILD_TESTS})
set(TURBOWASM_BUILD_TOOLS ON)
set(TURBOWASM_ENABLE_COMPONENT ON)
set(TURBOWASM_ENABLE_WASI02_ADAPTER ON)
set(TURBOWASM_ENABLE_WASI02_CNET_ADAPTER ON)
set(TURBOWASM_ENABLE_WASI02_SOCKET_BACKEND ON)
set(TURBOWASM_ENABLE_CFLOW_ADAPTER ON)
set(TURBOWASM_ENABLE_NATIVE_IO_ADAPTER ON)
set(TURBOWASM_ENABLE_WASI_ADAPTER ON)
set(TURBOWASM_ENABLE_WASI_THREADS_ADAPTER ON)
set(TURBOWASM_ENABLE_WASI_NATIVE_IO_ADAPTER ON)
set(TURBOWASM_ENABLE_WASI_HOST_FS_ADAPTER ON)
set(TURBOWASM_TYPE_DEPENDENCY_LIMIT 256)
set(TURBOWASM_SANITIZER_STACK_BYTES 8388608)
# The published MIR port excludes Windows ARM64.
set(TURBOWASM_ENABLE_MIR_JIT ON)
if(WIN32 AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(ARM64|arm64|aarch64|AARCH64)$")
  set(TURBOWASM_ENABLE_MIR_JIT OFF)
endif()
if(TURBOWASM_LITTLEFS_SOURCE_DIR)
  set(TURBOWASM_ENABLE_WASI_LITTLEFS_ADAPTER ON)
endif()
if(TURBOWASM_SPEC_ROOT)
  set(TURBOWASM_BUILD_CONFORMANCE_RUNNER ON)
endif()
if(NOT DEFINED TURBOWASM_BUILD_METALLIC_GUESTS)
  set(TURBOWASM_BUILD_METALLIC_GUESTS OFF)
endif()
if(NOT DEFINED TURBOWASM_BUILD_METALLIC_THREADS)
  set(TURBOWASM_BUILD_METALLIC_THREADS OFF)
endif()
if(ENABLE_ASAN OR SALTSCORE_ENABLE_ASAN)
  set(ENABLE_SANITIZER_ADDRESS ON)
endif()
