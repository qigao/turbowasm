@PACKAGE_INIT@
set(_turbowasm_package_prefix "${PACKAGE_PREFIX_DIR}")

include(CMakeFindDependencyMacro)
find_dependency(SaltsBase CONFIG REQUIRED PATHS "$ENV{SALTS_BASE_ROOT}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
find_dependency(CMeta CONFIG REQUIRED PATHS "$ENV{CMETA_ROOT}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
find_dependency(SaltsCNet CONFIG REQUIRED PATHS "$ENV{SALTSCORE_ROOT}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
find_dependency(SaltsUtils CONFIG REQUIRED PATHS "$ENV{SALTS_UTILS_ROOT}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
find_dependency(Chttp CONFIG REQUIRED PATHS "$ENV{CHTTP_ROOT}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)

include("${CMAKE_CURRENT_LIST_DIR}/TurboWasmTargets.cmake")

set(TurboWasm_HAS_METALLIC_GUEST_SDK @TURBOWASM_BUILD_METALLIC_GUESTS@)
set(TurboWasm_HAS_METALLIC_THREADS @TURBOWASM_BUILD_METALLIC_THREADS@)
if(TurboWasm_HAS_METALLIC_GUEST_SDK)
  set_and_check(TurboWasm_GUEST_SDK_DIR "${_turbowasm_package_prefix}/share/turbowasm/guest")
endif()
unset(_turbowasm_package_prefix)

check_required_components(TurboWasm)
