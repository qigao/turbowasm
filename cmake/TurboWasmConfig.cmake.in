@PACKAGE_INIT@
set(_turbowasm_package_prefix "${PACKAGE_PREFIX_DIR}")

include(CMakeFindDependencyMacro)
find_dependency(Salts CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/TurboWasmTargets.cmake")

set(TurboWasm_HAS_METALLIC_GUEST_SDK @TURBOWASM_BUILD_METALLIC_GUESTS@)
if(TurboWasm_HAS_METALLIC_GUEST_SDK)
  set_and_check(TurboWasm_GUEST_SDK_DIR "${_turbowasm_package_prefix}/share/turbowasm/guest")
endif()
unset(_turbowasm_package_prefix)

check_required_components(TurboWasm)
