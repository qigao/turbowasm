(module
  (type $node (struct (field i32)))
  (type $other (struct (field i64)))
  (import "h" "collect" (func $collect))
  (global $g_any (export "g_any") (mut anyref) ref.null any)
  (global $g_vec (export "g_vec") (mut v128) v128.const i32x4 0 0 0 0)
  (global $g_i32 (mut i32) i32.const 0)
  (global $g_i64 (mut i64) i64.const 0)
  (global $g_f32 (mut f32) f32.const 0)
  (global $g_f64 (mut f64) f64.const 0)
  (global $g_ext (mut externref) ref.null extern)
  (global $g_fun (export "g_fun") (mut funcref) ref.null func)
  (global $g_exn (mut exnref) ref.null exn)
  (global $g_const i32 i32.const 91)
  (table $wide i64 4 8 anyref)
  (table $narrow 4 8 anyref)
  (table $funcs i64 2 4 funcref)
  (elem declare func $one)
  (func $make (export "make") (param i32) (result (ref $node)) local.get 0 struct.new $node)
  (func (export "other") (result (ref $other)) i64.const 3 struct.new $other)
  (func (export "read") (param (ref $node)) (result i32) local.get 0 struct.get $node 0)
  (func $id (export "id") (param (ref $node)) (result (ref $node)) local.get 0)
  (func (export "local") (param anyref) (result anyref) (local anyref)
    local.get 0 local.tee 1 drop ref.null any local.set 0 local.get 1)
  (func (export "select") (param anyref anyref i32) (result anyref)
    local.get 0 local.get 1 local.get 2 select (result anyref))
  (func (export "branch") (param i32 anyref anyref) (result anyref)
    local.get 0 if (result anyref) local.get 1 else local.get 2 end)
  (func (export "br") (param anyref) (result anyref)
    block (result anyref) local.get 0 br 0 end)
  (func (export "call") (param (ref $node)) (result (ref $node)) local.get 0 call $id)
  (func (export "tail") (param (ref $node)) (result (ref $node)) local.get 0 return_call $id)
  (func (export "tuple") (param anyref externref funcref) (result funcref anyref externref)
    local.get 2 local.get 0 local.get 1)
  (func (export "null") (result anyref externref funcref exnref)
    ref.null any ref.null extern ref.null func ref.null exn)
  (func (export "is-null") (param anyref) (result i32) local.get 0 ref.is_null)
  (func (export "non-null") (param anyref) (result (ref any)) local.get 0 ref.as_non_null)
  (func (export "equal") (param eqref eqref) (result i32) local.get 0 local.get 1 ref.eq)
  (func (export "function") (result funcref) ref.func $one)
  (func $one (export "one") (result i32) i32.const 1)
  (func (export "live-local") (param i32) (result anyref) (local anyref)
    local.get 0 call $make local.set 1 call $collect local.get 1)
  (func (export "loop") (param i32) (result anyref) (local anyref anyref)
    loop
      local.get 0 call $make local.set 2
      local.get 1 ref.is_null if local.get 2 local.set 1 end
      call $collect
      local.get 0 i32.const 1 i32.sub local.tee 0 br_if 0
    end
    local.get 1)
  (func $tail-a (export "tail-a") (param i32 anyref externref funcref) (result anyref externref funcref)
    local.get 0 if (result anyref externref funcref)
      local.get 0 i32.const 1 i32.sub local.get 1 local.get 2 local.get 3 return_call $tail-b
    else local.get 1 local.get 2 local.get 3 end)
  (func $tail-b (param i32 anyref externref funcref) (result anyref externref funcref)
    call $collect local.get 0 local.get 1 local.get 2 local.get 3 return_call $tail-a)
  (func (export "get64") (param i64) (result anyref) local.get 0 table.get $wide)
  (func (export "set64") (param i64 anyref) local.get 0 local.get 1 table.set $wide)
  (func (export "grow64") (param anyref i64) (result i64) local.get 0 local.get 1 table.grow $wide)
  (func (export "fill64") (param i64 anyref i64) local.get 0 local.get 1 local.get 2 table.fill $wide)
  (func (export "get32") (param i32) (result anyref) local.get 0 table.get $narrow)
  (func (export "set32") (param i32 anyref) local.get 0 local.get 1 table.set $narrow)
  (func (export "grow32") (param anyref i32) (result i32) local.get 0 local.get 1 table.grow $narrow)
  (func (export "fill32") (param i32 anyref i32) local.get 0 local.get 1 local.get 2 table.fill $narrow)
  (func (export "set-function") (param i64) local.get 0 ref.func $one table.set $funcs)
  (func (export "get-function") (param i64) (result funcref) local.get 0 table.get $funcs)
  (func $self (export "self") (param i32 anyref) (result anyref) (local anyref)
    local.get 0 if (result anyref)
      local.get 1 local.set 2
      local.get 0 i32.const 1 i32.sub local.get 1 return_call $self
    else local.get 2 end)
  (func $recursive (export "recursive") (param i32 anyref) (result anyref)
    local.get 0 if (result anyref)
      local.get 0 i32.const 1 i32.sub local.get 1 call $recursive
    else local.get 1 end)
  (func (export "br-null") (param anyref) (result i32)
    block (result i32) i32.const 11 local.get 0 br_on_null 0 drop drop i32.const 22 end)
  (func (export "br-non-null") (param anyref) (result anyref)
    block (result (ref any)) local.get 0 br_on_non_null 0 ref.null any return end)
  (func (export "return-null") (param anyref) (result i32)
    i32.const 11 local.get 0 br_on_null 0 drop drop i32.const 22)
  (func (export "return-non-null") (param anyref) (result anyref)
    local.get 0 br_on_non_null 0 ref.null any)
  (func (export "loop-null") (param anyref anyref) (result i32)
    i32.const 0 loop (param i32) (result i32)
      i32.const 1 i32.add local.get 0 local.get 1 local.set 0 br_on_null 0 drop end)
  (func (export "loop-non-null") (param i32 anyref) (result anyref)
    i32.const 0 local.get 1 loop (param i32 anyref) (result anyref)
      local.set 1 local.set 0
      local.get 0 i32.const 1 i32.add
      local.get 0 if (result anyref) ref.null any else local.get 1 end
      br_on_non_null 0 drop local.get 1 end)
  (func (export "br-extern") (param externref) (result externref)
    local.get 0 br_on_non_null 0 ref.null extern)
  (func (export "br-function") (param funcref) (result funcref)
    local.get 0 br_on_non_null 0 ref.null func)
  (func (export "br-exception") (param exnref) (result i32)
    i32.const 11 local.get 0 br_on_null 0 drop drop i32.const 22)
  (func (export "get-any") (result anyref) global.get $g_any)
  (func (export "set-any") (param anyref) local.get 0 global.set $g_any)
  (func (export "global-live") (param i32) (result anyref)
    local.get 0 call $make global.set $g_any call $collect global.get $g_any)
  (func (export "get-vector") (result v128) global.get $g_vec)
  (func (export "set-vector") (param v128) local.get 0 global.set $g_vec)
  (func (export "global-scalars") (param i32 i64 f32 f64) (result f64 f32 i64 i32)
    local.get 0 global.set $g_i32 local.get 1 global.set $g_i64
    local.get 2 global.set $g_f32 local.get 3 global.set $g_f64
    global.get $g_f64 global.get $g_f32 global.get $g_i64 global.get $g_i32)
  (func (export "global-refs") (param externref funcref exnref) (result exnref funcref externref)
    local.get 0 global.set $g_ext local.get 1 global.set $g_fun local.get 2 global.set $g_exn
    global.get $g_exn global.get $g_fun global.get $g_ext)
  (func (export "global-const") (result i32) global.get $g_const)
  (func (export "trap") (result i32) unreachable)
  (func (export "trap-arm") (param i32) (result i32)
    local.get 0 if (result i32) unreachable else i32.const 17 end)
)
