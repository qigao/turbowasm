(module
  (table $wide (export "wide") i64 8 16 funcref)
  (table $narrow 8 16 funcref)
  (table $second i64 8 16 funcref)
  (elem $payload func $one $two $one)
  (func (result i64) table.size $wide)
  (func (result i32) table.size $narrow)
  (func (param i64 i32 i32)
    local.get 0 local.get 1 local.get 2 table.init $wide $payload)
  (func (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 table.init $narrow $payload)
  (func elem.drop $payload)
  (func (param i64 i64 i64)
    local.get 0 local.get 1 local.get 2 table.copy $wide $wide)
  (func (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 table.copy $narrow $narrow)
  (func (param i64 i32 i32)
    local.get 0 local.get 1 local.get 2 table.copy $wide $narrow)
  (func (param i32 i64 i32)
    local.get 0 local.get 1 local.get 2 table.copy $narrow $wide)
  (func (param i64 i64 i64)
    local.get 0 local.get 1 local.get 2 table.copy $second $wide)
  (func (param i32) (result i64)
    local.get 0 if (result i64) table.size $wide else table.size $second end)
  (func $one (result i32) i32.const 11)
  (func $two (result i32) i32.const 22)
)
