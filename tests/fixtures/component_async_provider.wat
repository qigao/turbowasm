(component
  (type $number (func async (result u32)))
  (type $scalar (func async (param "x" u32) (result u32)))
  (type $text (func async (param "x" string) (result string)))
  (type $stream (stream u32))
  (type $mixed (tuple $stream string))
  (type $echo (func async (param "x" $mixed) (result $mixed)))
  (core func $get (canon context.get i32 0))
  (core func $set (canon context.set i32 0))
  (core instance $context (export "get" (func $get)) (export "set" (func $set)))
  (core module $memory
    (import "c" "get" (func $get (result i32)))
    (import "c" "set" (func $set (param i32)))
    (memory (export "memory") i64 1)
    (func (export "realloc") (param i64 i64 i64 i64) (result i64) (local $n i32)
      call $get if unreachable end i32.const 55 call $set
      i32.const 30 local.set $n
      loop $loop local.get $n i32.const 1 i32.sub local.tee $n br_if $loop end
      i64.const 1024))
  (core instance $memory (instantiate $memory (with "c" (instance $context))))
  (alias core export $memory "memory" (core memory $memory))
  (alias core export $memory "realloc" (core func $realloc))
  (core func $number (canon task.return (result u32) (memory $memory)))
  (core func $text (canon task.return (result string) (memory $memory)))
  (core func $mixed (canon task.return (result $mixed) (memory $memory)))
  (core func $cancel (canon task.cancel))
  (core instance $a
    (export "number" (func $number)) (export "text" (func $text)) (export "mixed" (func $mixed))
    (export "get" (func $get)) (export "set" (func $set)) (export "cancel" (func $cancel)))
  (core module $worker
    (import "a" "number" (func $number (param i32)))
    (import "a" "text" (func $text (param i64 i64)))
    (import "a" "mixed" (func $mixed (param i32 i64 i64)))
    (import "a" "get" (func $get (result i32)))
    (import "a" "set" (func $set (param i32)))
    (import "a" "cancel" (func $cancel))
    (func (export "scalar") (param i32) local.get 0 i32.const 1 i32.add call $number)
    (func (export "slow") (result i32) i32.const 1)
    (func (export "early") (result i32) i32.const 43 call $number i32.const 1)
    (func (export "callback") (param i32 i32 i32) (result i32)
      local.get 0 i32.const 6 i32.eq if call $cancel else i32.const 44 call $number end i32.const 0)
    (func (export "exit") (param i32 i32 i32) (result i32) i32.const 0)
    (func (export "text") (param i64 i64)
      i32.const 67 call $set local.get 0 local.get 1 call $text
      call $get i32.const 67 i32.ne if unreachable end)
    (func (export "mixed") (param i32 i64 i64) local.get 0 local.get 1 local.get 2 call $mixed)
    (func (export "trap") unreachable))
  (core instance $worker (instantiate $worker (with "a" (instance $a))))
  (alias core export $worker "scalar" (core func $scalar))
  (alias core export $worker "slow" (core func $slow))
  (alias core export $worker "early" (core func $early))
  (alias core export $worker "callback" (core func $callback))
  (alias core export $worker "exit" (core func $exit))
  (alias core export $worker "text" (core func $text-entry))
  (alias core export $worker "mixed" (core func $mixed-entry))
  (alias core export $worker "trap" (core func $trap))
  (func (export "scalar") (type $scalar) (canon lift (core func $scalar) async (memory $memory)))
  (func (export "slow") (type $number) (canon lift (core func $slow) async (callback $callback) (memory $memory)))
  (func (export "early") (type $number) (canon lift (core func $early) async (callback $exit) (memory $memory)))
  (func (export "text") (type $text) (canon lift (core func $text-entry) async (memory $memory) (realloc $realloc)))
  (func (export "mixed") (type $echo) (canon lift (core func $mixed-entry) async (memory $memory) (realloc $realloc)))
  (func (export "trap") (type $number) (canon lift (core func $trap) async (memory $memory)))
)
