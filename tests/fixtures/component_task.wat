(module
  (import "t" "control" (func $control (result i32)))
  (import "t" "callback" (func $callback (param i32 i32 i32) (result i32)))
  (import "t" "return" (func $return (param i32)))
  (import "t" "cancel" (func $cancel))
  (import "t" "wait" (func $wait))
  (memory 1)
  (memory i64 1)
  (data (memory 0) (i32.const 0) "hello")
  (data (memory 1) (i64.const 0) "hello")
  (tag $failure)
  (func (export "entry") (result i32) call $control)
  (func (export "callback") (param i32 i32 i32) (result i32)
    local.get 0 local.get 1 local.get 2 call $callback)
  (func (export "return-yield") (result i32)
    i32.const 42 call $return i32.const 1)
  (func (export "stackful") i32.const 42 call $return)
  (func (export "wait-return") call $wait i32.const 42 call $return)
  (func (export "return-wait") i32.const 42 call $return call $wait)
  (func (export "no-return"))
  (func (export "invalid-code") (result i32) i32.const 3)
  (func (export "argument") (param i32) local.get 0 call $return)
  (func (export "fuel") (param i32)
    (loop $again
      local.get 0 i32.const 1 i32.sub local.tee 0 br_if $again)
    i32.const 42 call $return)
  (func (export "guest-callback") (param i32 i32 i32) (result i32)
    local.get 0 i32.const 6 i32.eq
    if call $cancel else i32.const 42 call $return end
    i32.const 0)
  (func (export "throw-entry") throw $failure)
  (func (export "throw-callback") (param i32 i32 i32) (result i32) throw $failure)
  (func (export "stack-cancel") call $wait call $cancel)
  (func (export "cancel-early") call $cancel)
)
