;; Distinct nominal resources with observable destructors and borrowed calls.
(component
  (core module $state
    (global $drops (mut i32) (i32.const 0))
    (func (export "drop") (param i32)
      global.get $drops i32.const 1 i32.add global.set $drops
      local.get 0 i32.const -1 i32.eq if unreachable end)
    (func (export "drops") (result i32) global.get $drops))
  (core instance $state-i (instantiate $state))
  (alias core export $state-i "drop" (core func $dtor))
  (alias core export $state-i "drops" (core func $drops))
  (type $r-def (resource (rep i32) (dtor (core func $dtor))))
  (export $r "resource-r" (type $r-def))
  (type $s-def (resource (rep i32) (dtor (core func $dtor))))
  (export $s "resource-s" (type $s-def))
  (core func $new-r (canon resource.new $r-def))
  (core func $rep-r (canon resource.rep $r-def))
  (core func $drop-r (canon resource.drop $r-def))
  (core func $new-s (canon resource.new $s-def))
  (core instance $builtins
    (export "new-r" (func $new-r)) (export "rep-r" (func $rep-r))
    (export "drop-r" (func $drop-r)) (export "new-s" (func $new-s)))
  (core module $m
    (import "resources" "new-r" (func $new (param i32) (result i32)))
    (import "resources" "rep-r" (func $rep (param i32) (result i32)))
    (import "resources" "drop-r" (func $drop (param i32)))
    (import "resources" "new-s" (func $new-s (param i32) (result i32)))
    (memory (export "memory") 1)
    (global $heap (mut i32) (i32.const 1024))
    (func (export "realloc") (param i32 i32 i32 i32) (result i32)
      (local $p i32)
      global.get $heap local.get 2 i32.const 1 i32.sub i32.add
      i32.const 0 local.get 2 i32.sub i32.and local.tee $p
      local.get 3 i32.add global.set $heap local.get $p)
    (func (export "make") (param i32) (result i32) local.get 0 call $new)
    (func (export "make-s") (param i32) (result i32) local.get 0 call $new-s)
    (func (export "echo") (param i32) (result i32) local.get 0)
    (func (export "consume") (param i32) (result i32)
      local.get 0 call $rep local.get 0 call $drop)
    (func (export "two") (param i32 i32) (result i32)
      local.get 0 call $rep local.get 1 call $rep i32.add
      local.get 0 call $drop local.get 1 call $drop)
    (func (export "text") (param i32 i32 i32) (result i32)
      local.get 0 call $rep local.get 0 call $drop)
    (func (export "spin") (param i32) (result i32)
      (local $n i32)
      i32.const 40 local.set $n
      loop $again
        local.get $n i32.const 1 i32.sub local.tee $n br_if $again
      end
      local.get 0)
    (func (export "trap") (param i32) (result i32) unreachable)
    (func (export "pair") (param i32 i32) (result i32)
      i32.const 0 local.get 0 call $new i32.store
      i32.const 4 local.get 1 call $new i32.store i32.const 0)
    (func (export "bad-pair") (param i32) (result i32)
      i32.const 0 local.get 0 call $new i32.store
      i32.const 4 i32.const 2 i32.store i32.const 0)
    (func (export "echo-list") (param i32 i32) (result i32)
      i32.const 0 local.get 0 i32.store
      i32.const 4 local.get 1 i32.store i32.const 0))
  (core instance $i (instantiate $m (with "resources" (instance $builtins))))
  (alias core export $i "memory" (core memory $mem))
  (alias core export $i "realloc" (core func $realloc))
  (alias core export $i "make" (core func $make))
  (alias core export $i "make-s" (core func $make-s))
  (alias core export $i "echo" (core func $echo))
  (alias core export $i "consume" (core func $consume))
  (alias core export $i "two" (core func $two))
  (alias core export $i "text" (core func $text))
  (alias core export $i "spin" (core func $spin))
  (alias core export $i "trap" (core func $trap))
  (alias core export $i "pair" (core func $pair))
  (alias core export $i "bad-pair" (core func $bad-pair))
  (alias core export $i "echo-list" (core func $echo-list))
  (type $pair-def (tuple (own $r) (own $r)))
  (export $pair-type "resource-pair" (type $pair-def))
  (type $enum-def (enum "ok"))
  (export $enum "one-case" (type $enum-def))
  (type $bad-pair-def (tuple (own $r) $enum))
  (export $bad-pair-type "bad-resource-pair" (type $bad-pair-def))
  (type $list-def (list (own $r)))
  (export $list "resource-list" (type $list-def))
  (func (export "make") (param "rep" s32) (result (own $r)) (canon lift (core func $make)))
  (func (export "make-s") (param "rep" s32) (result (own $s)) (canon lift (core func $make-s)))
  (func (export "drops") (result u32) (canon lift (core func $drops)))
  (func (export "echo") (param "value" (own $r)) (result (own $r)) (canon lift (core func $echo)))
  (func (export "consume") (param "value" (own $r)) (result s32) (canon lift (core func $consume)))
  (func (export "borrow") (param "value" (borrow $r)) (result s32) (canon lift (core func $echo)))
  (func (export "two") (param "a" (own $r)) (param "b" (own $r)) (result s32) (canon lift (core func $two)))
  (func (export "own-and-borrow") (param "a" (own $r)) (param "b" (borrow $r)) (result s32) (canon lift (core func $two)))
  (func (export "text") (param "value" (own $r)) (param "text" string) (result s32)
    (canon lift (core func $text) (memory $mem) (realloc $realloc)))
  (func (export "spin") (param "value" (borrow $r)) (result s32) (canon lift (core func $spin)))
  (func (export "trap") (param "value" (own $r)) (result s32) (canon lift (core func $trap)))
  (func (export "pair") (param "a" s32) (param "b" s32) (result $pair-type)
    (canon lift (core func $pair) (memory $mem)))
  (func (export "bad-pair") (param "rep" s32) (result $bad-pair-type)
    (canon lift (core func $bad-pair) (memory $mem)))
  (func (export "echo-list") (param "value" $list) (result $list)
    (canon lift (core func $echo-list) (memory $mem) (realloc $realloc)))
)
