;; Retained host task roots: parameters, resources, callback cancellation and
;; task.return all execute actual Core bodies with the shared execution control.
(component
  (core module $state
    (memory (export "m32") 1)
    (memory (export "m64") i64 1)
    (global $heap32 (mut i32) (i32.const 1024))
    (global $heap64 (mut i64) (i64.const 1024))
    (global $drops (mut i32) (i32.const 0))
    (func (export "drop") (param i32)
      global.get $drops i32.const 1 i32.add global.set $drops
      local.get 0 i32.const -1 i32.eq if unreachable end)
    (func (export "drops") (result i32) global.get $drops)
    (func $spin (local $n i32)
      i32.const 40 local.set $n
      loop $again local.get $n i32.const 1 i32.sub local.tee $n br_if $again end)
    (func (export "r32") (param i32 i32 i32 i32) (result i32) (local $p i32)
      local.get 3 i32.const 13 i32.eq if unreachable end
      call $spin
      global.get $heap32 local.get 2 i32.const 1 i32.sub i32.add
      i32.const 0 local.get 2 i32.sub i32.and local.tee $p
      local.get 3 i32.add global.set $heap32 local.get $p)
    (func (export "r64") (param i64 i64 i64 i64) (result i64) (local $p i64)
      local.get 3 i64.const 13 i64.eq if unreachable end
      call $spin
      global.get $heap64 local.get 2 i64.const 1 i64.sub i64.add
      i64.const 0 local.get 2 i64.sub i64.and local.tee $p
      local.get 3 i64.add global.set $heap64 local.get $p))
  (core instance $state (instantiate $state))
  (alias core export $state "drop" (core func $drop))
  (alias core export $state "drops" (core func $drops))
  (alias core export $state "m32" (core memory $m32))
  (alias core export $state "m64" (core memory $m64))
  (alias core export $state "r32" (core func $r32))
  (alias core export $state "r64" (core func $r64))
  (type $r-def (resource (rep i32) (dtor (core func $drop))))
  (export $r "resource-r" (type $r-def))
  (core func $new (canon resource.new $r-def))
  (core func $rep (canon resource.rep $r-def))
  (core func $resource-drop (canon resource.drop $r-def))
  (core func $return (canon task.return (result u32)))
  (core func $number32 (canon task.return (result u32) (memory $m32)))
  (core func $return32 (canon task.return (result string) (memory $m32)))
  (core func $return64 (canon task.return (result string) (memory $m64)))
  (core func $return-own (canon task.return (result (own $r))))
  (core func $return-unit (canon task.return))
  (core func $yield (canon thread.yield))
  (core func $cancel (canon task.cancel))
  (type $stream (stream u32))
  (type $future (future u32))
  (core func $stream-new (canon stream.new $stream))
  (core func $stream-read (canon stream.read $stream async (memory $m32)))
  (core func $stream-drop-read (canon stream.drop-readable $stream))
  (core func $stream-drop-write (canon stream.drop-writable $stream))
  (core func $packed (canon task.return (result u64)))
  (core instance $a
    (export "new" (func $new)) (export "rep" (func $rep)) (export "drop" (func $resource-drop))
    (export "return" (func $return)) (export "number32" (func $number32))
    (export "text32" (func $return32)) (export "text64" (func $return64))
    (export "own" (func $return-own)) (export "unit" (func $return-unit))
    (export "yield" (func $yield)) (export "cancel" (func $cancel))
    (export "stream-new" (func $stream-new)) (export "stream-read" (func $stream-read))
    (export "stream-drop-read" (func $stream-drop-read))
    (export "stream-drop-write" (func $stream-drop-write)) (export "packed" (func $packed)))
  (core module $worker
    (import "a" "new" (func $new (param i32) (result i32)))
    (import "a" "rep" (func $rep (param i32) (result i32)))
    (import "a" "drop" (func $drop (param i32)))
    (import "a" "return" (func $return (param i32)))
    (import "a" "number32" (func $number32 (param i32)))
    (import "a" "text32" (func $text32 (param i32 i32)))
    (import "a" "text64" (func $text64 (param i64 i64)))
    (import "a" "own" (func $own (param i32)))
    (import "a" "unit" (func $unit))
    (import "a" "yield" (func $yield (result i32)))
    (import "a" "cancel" (func $cancel))
    (import "a" "stream-new" (func $stream-new (result i64)))
    (import "a" "stream-read" (func $stream-read (param i32 i32 i32) (result i32)))
    (import "a" "stream-drop-read" (func $stream-drop-read (param i32)))
    (import "a" "stream-drop-write" (func $stream-drop-write (param i32)))
    (import "a" "packed" (func $packed (param i64)))
    (import "m" "m32" (memory $m32 1))
    (import "m" "m64" (memory $m64 i64 1))
    (func (export "make") (param i32) (result i32) local.get 0 call $new)
    (func (export "answer") i32.const 42 call $return)
    (func (export "pair-stream") call $stream-new call $packed)
    (func (export "read-stream") (param i32)
      local.get 0 i32.const 128 i32.const 1 call $stream-read call $number32)
    (func (export "drop-stream-read") (param i32) local.get 0 call $stream-drop-read call $unit)
    (func (export "drop-stream-write") (param i32) local.get 0 call $stream-drop-write call $unit)
    (func (export "unit") call $unit)
    (func (export "echo32") (param i32 i32) local.get 0 local.get 1 call $text32)
    (func (export "echo64") (param i64 i64) local.get 0 local.get 1 call $text64)
    (func (export "wide") (param i32)
      local.get 0 i32.load $m32 local.get 0 i32.load $m32 offset=64 i32.add call $number32)
    (func (export "consume") (param i32)
      local.get 0 call $rep local.get 0 call $drop call $return)
    (func (export "consume-text") (param i32 i32 i32)
      local.get 0 call $rep local.get 0 call $drop call $number32)
    (func (export "echo-own") (param i32) local.get 0 call $own)
    (func (export "borrow") (param i32) local.get 0 call $return)
    (func (export "yield")
      call $yield drop i32.const 43 call $return)
    (func (export "callback-entry") (result i32) i32.const 1)
    (func (export "callback") (param i32 i32 i32) (result i32)
      local.get 0 i32.const 6 i32.eq
      if call $cancel else i32.const 44 call $return end i32.const 0)
    (func (export "trap") unreachable)
    (func (export "trap-after-return") i32.const 42 call $return unreachable)
    (func (export "own-trap-after-return") (param i32) local.get 0 call $own unreachable))
  (core instance $worker (instantiate $worker (with "a" (instance $a)) (with "m" (instance $state))))
  (alias core export $worker "make" (core func $make))
  (alias core export $worker "answer" (core func $answer))
  (alias core export $worker "pair-stream" (core func $pair-stream))
  (alias core export $worker "read-stream" (core func $read-stream))
  (alias core export $worker "drop-stream-read" (core func $drop-stream-read))
  (alias core export $worker "drop-stream-write" (core func $drop-stream-write))
  (alias core export $worker "unit" (core func $unit))
  (alias core export $worker "echo32" (core func $echo32))
  (alias core export $worker "echo64" (core func $echo64))
  (alias core export $worker "wide" (core func $wide))
  (alias core export $worker "consume" (core func $consume))
  (alias core export $worker "consume-text" (core func $consume-text))
  (alias core export $worker "echo-own" (core func $echo-own))
  (alias core export $worker "borrow" (core func $borrow))
  (alias core export $worker "yield" (core func $yield-entry))
  (alias core export $worker "callback-entry" (core func $entry))
  (alias core export $worker "callback" (core func $callback))
  (alias core export $worker "trap" (core func $trap))
  (alias core export $worker "trap-after-return" (core func $trap-after))
  (alias core export $worker "own-trap-after-return" (core func $own-trap-after))
  (type $wide-def (tuple s32 s32 s32 s32 s32 s32 s32 s32 s32 s32 s32 s32 s32 s32 s32 s32 s32))
  (export $wide "wide-type" (type $wide-def))
  (type $answer-type (func async (result u32)))
  (type $packed-type (func async (result u64)))
  (type $read-stream-type (func async (param "handle" u32) (result u32)))
  (type $drop-stream-type (func async (param "handle" u32)))
  (type $unit-type (func async))
  (type $text-type (func async (param "value" string) (result string)))
  (type $wide-type (func async (param "value" $wide) (result u32)))
  (type $consume-type (func async (param "value" (own $r)) (result u32)))
  (type $consume-text-type (func async (param "value" (own $r)) (param "text" string) (result u32)))
  (type $echo-own-type (func async (param "value" (own $r)) (result (own $r))))
  (type $borrow-type (func async (param "value" (borrow $r)) (result u32)))
  (func (export "make") (param "rep" s32) (result (own $r)) (canon lift (core func $make)))
  (func (export "drops") (result u32) (canon lift (core func $drops)))
  (func (export "answer") (type $answer-type) (canon lift (core func $answer) async))
  (func (export "pair-stream") (type $packed-type) (canon lift (core func $pair-stream) async))
  (func (export "read-stream") (type $read-stream-type) (canon lift (core func $read-stream) async (memory $m32)))
  (func (export "drop-stream-read") (type $drop-stream-type) (canon lift (core func $drop-stream-read) async))
  (func (export "drop-stream-write") (type $drop-stream-type) (canon lift (core func $drop-stream-write) async))
  (func (export "unit") (type $unit-type) (canon lift (core func $unit) async))
  (func (export "echo32") (type $text-type) (canon lift (core func $echo32) async (memory $m32) (realloc $r32)))
  (func (export "echo64") (type $text-type) (canon lift (core func $echo64) async (memory $m64) (realloc $r64)))
  (func (export "wide") (type $wide-type) (canon lift (core func $wide) async (memory $m32) (realloc $r32)))
  (func (export "consume") (type $consume-type) (canon lift (core func $consume) async))
  (func (export "consume-text") (type $consume-text-type)
    (canon lift (core func $consume-text) async (memory $m32) (realloc $r32)))
  (func (export "echo-own") (type $echo-own-type) (canon lift (core func $echo-own) async))
  (func (export "borrow") (type $borrow-type) (canon lift (core func $borrow) async))
  (func (export "yield") (type $answer-type) (canon lift (core func $yield-entry) async))
  (func (export "callback") (type $answer-type) (canon lift (core func $entry) async (callback $callback)))
  (func (export "trap") (type $answer-type) (canon lift (core func $trap) async))
  (func (export "trap-after-return") (type $answer-type) (canon lift (core func $trap-after) async))
  (func (export "own-trap-after-return") (type $echo-own-type) (canon lift (core func $own-trap-after) async)))
