(component
  (core module $state
    (global $drops (mut i32) (i32.const 0))
    (global $posts (mut i32) (i32.const 0))
    (func (export "drop") (param i32)
      global.get $drops i32.const 1 i32.add global.set $drops)
    (func (export "drops") (result i32) global.get $drops)
    (func (export "post") (param i32) (local $n i32)
      global.get $posts i32.const 1 i32.add global.set $posts
      i32.const 8 local.set $n
      loop $again local.get $n i32.const 1 i32.sub local.tee $n br_if $again end)
    (func (export "trap") (param i32) unreachable))
  (core instance $s (instantiate $state))
  (alias core export $s "drop" (core func $dtor))
  (alias core export $s "drops" (core func $drops))
  (alias core export $s "post" (core func $post))
  (alias core export $s "trap" (core func $trap))
  (type $r-def (resource (rep i32) (dtor (core func $dtor))))
  (export $r "resource-r" (type $r-def))
  (core func $new (canon resource.new $r-def))
  (core func $drop (canon resource.drop $r-def))
  (core func $rep (canon resource.rep $r-def))
  (core instance $builtins
    (export "new" (func $new)) (export "drop" (func $drop)) (export "rep" (func $rep)))
  (core module $m
    (import "r" "new" (func $new (param i32) (result i32)))
    (import "r" "drop" (func $drop (param i32)))
    (import "r" "rep" (func $rep (param i32) (result i32)))
    (global $last (mut i32) (i32.const 0))
    (func (export "make") (result i32)
      i32.const 42 call $new global.set $last global.get $last)
    (func (export "cleanup") global.get $last call $drop)
    (func (export "post-drop") (param i32) local.get 0 call $drop)
    (func (export "post-new") (param i32) local.get 0 call $new drop)
    (func (export "post-rep") (param i32)
      local.get 0 call $rep i32.const 42 i32.ne if unreachable end))
  (core instance $i (instantiate $m (with "r" (instance $builtins))))
  (alias core export $i "make" (core func $make))
  (alias core export $i "cleanup" (core func $cleanup))
  (alias core export $i "post-drop" (core func $post-drop))
  (alias core export $i "post-new" (core func $post-new))
  (alias core export $i "post-rep" (core func $post-rep))
  (func (export "make") (result (own $r)) (canon lift (core func $make) (post-return $post)))
  (func (export "trap") (result (own $r)) (canon lift (core func $make) (post-return $trap)))
  (func (export "drops") (result u32) (canon lift (core func $drops)))
  (func (export "cleanup") (canon lift (core func $cleanup)))
  (func (export "direct-drop") (result u32) (canon lift (core func $make) (post-return $drop)))
  (func (export "indirect-drop") (result u32) (canon lift (core func $make) (post-return $post-drop)))
  (func (export "indirect-new") (result u32) (canon lift (core func $make) (post-return $post-new)))
  (func (export "indirect-rep") (result u32) (canon lift (core func $make) (post-return $post-rep)))
)
