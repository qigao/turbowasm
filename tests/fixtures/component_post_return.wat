(component
  (core module $m
    (memory (export "memory") 1)
    (global $calls (mut i32) (i32.const 0))
    (global $last (mut i32) (i32.const 0))
    (tag $e)
    (data (i32.const 32) "hello")
    (func (export "text") (result i32)
      i32.const 0 i32.const 32 i32.store
      i32.const 4 i32.const 5 i32.store i32.const 0)
    (func (export "bad-text") (result i32)
      i32.const 32 i32.const 255 i32.store8
      i32.const 0 i32.const 32 i32.store
      i32.const 4 i32.const 1 i32.store i32.const 0)
    (func (export "scalar") (result i32) i32.const 42)
    (func (export "wide") (result i64) i64.const 0x123456789abcdef0)
    (func (export "float") (result f64) f64.const -3.5)
    (func (export "nothing"))
    (func (export "fail") (result i32) unreachable)
    (func (export "calls") (result i32) global.get $calls)
    (func (export "last") (result i32) global.get $last)
    (func $post (export "post") (param $p i32) (local $n i32)
      global.get $calls i32.const 1 i32.add global.set $calls
      local.get $p global.set $last
      i32.const 8 local.set $n
      loop $again
        local.get $n i32.const 1 i32.sub local.tee $n br_if $again
      end
      i32.const 32 i32.const 0 i32.const 5 memory.fill)
    (func (export "post-void") i32.const 99 call $post)
    (func (export "post-wide") (param i64)
      local.get 0 i64.const 0x123456789abcdef0 i64.ne if unreachable end
      i32.const 64 call $post)
    (func (export "post-float") (param f64)
      local.get 0 f64.const -3.5 f64.ne if unreachable end
      i32.const 65 call $post)
    (func (export "post-trap") (param i32) local.get 0 call $post unreachable)
    (func (export "post-throw") (param i32) local.get 0 call $post throw $e))
  (core module $other
    (global $last (mut i32) (i32.const 0))
    (func (export "post") (param i32) local.get 0 global.set $last)
    (func (export "last") (result i32) global.get $last))
  (core instance $i (instantiate $m))
  (core instance $j (instantiate $other))
  (alias core export $i "memory" (core memory $mem))
  (alias core export $i "text" (core func $text))
  (alias core export $i "bad-text" (core func $bad))
  (alias core export $i "scalar" (core func $scalar))
  (alias core export $i "wide" (core func $wide))
  (alias core export $i "float" (core func $float))
  (alias core export $i "nothing" (core func $nothing))
  (alias core export $i "fail" (core func $fail))
  (alias core export $i "calls" (core func $calls))
  (alias core export $i "last" (core func $last))
  (alias core export $i "post" (core func $post))
  (alias core export $i "post-void" (core func $pv))
  (alias core export $i "post-wide" (core func $pw))
  (alias core export $i "post-float" (core func $pf))
  (alias core export $i "post-trap" (core func $pt))
  (alias core export $i "post-throw" (core func $pe))
  (alias core export $j "post" (core func $other-post))
  (alias core export $j "last" (core func $other-last))
  (func (export "text") (result string)
    (canon lift (core func $text) (memory $mem) (post-return $post)))
  (func (export "bad-text") (result string)
    (canon lift (core func $bad) (memory $mem) (post-return $post)))
  (func (export "scalar") (result u32) (canon lift (core func $scalar) (post-return $post)))
  (func (export "wide") (result u64) (canon lift (core func $wide) (post-return $pw)))
  (func (export "float") (result f64) (canon lift (core func $float) (post-return $pf)))
  (func (export "nothing") (canon lift (core func $nothing) (post-return $pv)))
  (func (export "fail") (result u32) (canon lift (core func $fail) (post-return $post)))
  (func (export "trap") (result string)
    (canon lift (core func $text) (memory $mem) (post-return $pt)))
  (func (export "throw") (result string)
    (canon lift (core func $text) (memory $mem) (post-return $pe)))
  (func (export "cross") (result u32) (canon lift (core func $scalar) (post-return $other-post)))
  (func (export "calls") (result u32) (canon lift (core func $calls)))
  (func (export "last") (result u32) (canon lift (core func $last)))
  (func (export "other-last") (result u32) (canon lift (core func $other-last)))
)
