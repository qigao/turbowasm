;; Public host conversion fixture. Every list echo crosses canonical memory;
;; flat echoes additionally exercise discriminants and flag bits without lists.
(component
  (core module $m
    (memory (export "memory") 1)
    (global $heap (mut i32) (i32.const 1024))
    (func (export "realloc") (param i32 i32 i32 i32) (result i32)
      (local $p i32)
      global.get $heap local.get 2 i32.const 1 i32.sub i32.add
      i32.const 0 local.get 2 i32.sub i32.and local.tee $p
      local.get 3 i32.add global.set $heap local.get $p)
    (func (export "echo") (param i32 i32) (result i32)
      i32.const 0 local.get 0 i32.store
      i32.const 4 local.get 1 i32.store
      i32.const 1024 global.set $heap i32.const 0)
    (func (export "record") (param i64 i32 i32) (result i32)
      i32.const 0 local.get 0 i64.store
      i32.const 8 local.get 1 i32.store
      i32.const 12 local.get 2 i32.store i32.const 0)
    (func (export "words-3") (param i32 i32 i32) (result i32)
      i32.const 0 local.get 0 i32.store
      i32.const 4 local.get 1 i32.store
      i32.const 8 local.get 2 i32.store
      i32.const 0)
    (func (export "words-4") (param i32 i32 i32 i32) (result i32)
      i32.const 0 local.get 0 i32.store
      i32.const 4 local.get 1 i32.store
      i32.const 8 local.get 2 i32.store
      i32.const 12 local.get 3 i32.store
      i32.const 0)
    (func (export "words-5") (param i32 i32 i32 i32 i32) (result i32)
      i32.const 0 local.get 0 i32.store
      i32.const 4 local.get 1 i32.store
      i32.const 8 local.get 2 i32.store
      i32.const 12 local.get 3 i32.store
      i32.const 16 local.get 4 i32.store
      i32.const 0)
    (func (export "scalar") (param i32) (result i32) local.get 0)
    (func (export "bad-enum") (result i32) i32.const 3)
    (func (export "bad-flags") (result i32) i32.const 8)
  )
  (core instance $i (instantiate $m))
  (alias core export $i "memory" (core memory $mem))
  (alias core export $i "realloc" (core func $realloc))
  (alias core export $i "echo" (core func $echo))
  (alias core export $i "scalar" (core func $scalar))
  (alias core export $i "bad-enum" (core func $bad-enum))
  (alias core export $i "bad-flags" (core func $bad-flags))
  (alias core export $i "record" (core func $record))
  (alias core export $i "words-3" (core func $words-3))
  (alias core export $i "words-4" (core func $words-4))
  (alias core export $i "words-5" (core func $words-5))
  (type $def-enum (enum "red" "green" "blue"))
  (export $enum "enum-type" (type $def-enum))
  (type $def-list-enum (list $enum))
  (export $list-enum "enum-list" (type $def-list-enum))
  (func (export "echo-enum") (param "value" $list-enum) (result $list-enum)
    (canon lift (core func $echo) (memory $mem) (realloc $realloc)))
  (type $def-flags (flags "a" "b" "c"))
  (export $flags "flags-type" (type $def-flags))
  (type $def-list-flags (list $flags))
  (export $list-flags "flags-list" (type $def-list-flags))
  (func (export "echo-flags") (param "value" $list-flags) (result $list-flags)
    (canon lift (core func $echo) (memory $mem) (realloc $realloc)))
  (type $def-wide-flags (flags "f0" "f1" "f2" "f3" "f4" "f5" "f6" "f7" "f8" "f9" "f10" "f11" "f12" "f13" "f14" "f15" "f16" "f17" "f18" "f19" "f20" "f21" "f22" "f23" "f24" "f25" "f26" "f27" "f28" "f29" "f30" "f31"))
  (export $wide-flags "wide-flags-type" (type $def-wide-flags))
  (type $def-list-wide-flags (list $wide-flags))
  (export $list-wide-flags "wide-flags-list" (type $def-list-wide-flags))
  (func (export "echo-wide-flags") (param "value" $list-wide-flags) (result $list-wide-flags)
    (canon lift (core func $echo) (memory $mem) (realloc $realloc)))
  (type $def-tuple (tuple s32 string))
  (export $tuple "tuple-type" (type $def-tuple))
  (type $def-list-tuple (list $tuple))
  (export $list-tuple "tuple-list" (type $def-list-tuple))
  (func (export "echo-tuple") (param "value" $list-tuple) (result $list-tuple)
    (canon lift (core func $echo) (memory $mem) (realloc $realloc)))
  (type $def-record (record (field "number" u64) (field "text" string)))
  (export $record "record-type" (type $def-record))
  (type $def-list-record (list $record))
  (export $list-record "record-list" (type $def-list-record))
  (func (export "echo-record") (param "value" $list-record) (result $list-record)
    (canon lift (core func $echo) (memory $mem) (realloc $realloc)))
  (type $def-variant (variant (case "empty") (case "text" string) (case "pair" $tuple)))
  (export $variant "variant-type" (type $def-variant))
  (type $def-list-variant (list $variant))
  (export $list-variant "variant-list" (type $def-list-variant))
  (func (export "echo-variant") (param "value" $list-variant) (result $list-variant)
    (canon lift (core func $echo) (memory $mem) (realloc $realloc)))
  (type $def-option (option $variant))
  (export $option "option-type" (type $def-option))
  (type $def-list-option (list $option))
  (export $list-option "option-list" (type $def-list-option))
  (func (export "echo-option") (param "value" $list-option) (result $list-option)
    (canon lift (core func $echo) (memory $mem) (realloc $realloc)))
  (type $def-result (result $record (error $option)))
  (export $result "result-type" (type $def-result))
  (type $def-list-result (list $result))
  (export $list-result "result-list" (type $def-list-result))
  (func (export "echo-result") (param "value" $list-result) (result $list-result)
    (canon lift (core func $echo) (memory $mem) (realloc $realloc)))
  (type $def-nested (tuple $result $enum $flags $wide-flags))
  (export $nested "nested-type" (type $def-nested))
  (type $def-list-nested (list $nested))
  (export $list-nested "nested-list" (type $def-list-nested))
  (func (export "echo-nested") (param "value" $list-nested) (result $list-nested)
    (canon lift (core func $echo) (memory $mem) (realloc $realloc)))
  (func (export "flat-enum") (param "value" $enum) (result $enum) (canon lift (core func $scalar)))
  (func (export "flat-flags") (param "value" $flags) (result $flags) (canon lift (core func $scalar)))
  (func (export "flat-wide-flags") (param "value" $wide-flags) (result $wide-flags) (canon lift (core func $scalar)))
  (func (export "bad-enum") (result $enum) (canon lift (core func $bad-enum)))
  (func (export "bad-flags") (result $flags) (canon lift (core func $bad-flags)))
  (func (export "flat-record") (param "value" $record) (result $record)
    (canon lift (core func $record) (memory $mem) (realloc $realloc)))
  (func (export "flat-tuple") (param "value" $tuple) (result $tuple)
    (canon lift (core func $words-3) (memory $mem) (realloc $realloc)))
  (func (export "flat-variant") (param "value" $variant) (result $variant)
    (canon lift (core func $words-4) (memory $mem) (realloc $realloc)))
  (func (export "flat-option") (param "value" $option) (result $option)
    (canon lift (core func $words-5) (memory $mem) (realloc $realloc)))
  (type $simple-result-def (result u32 (error string)))
  (export $simple-result "simple-result" (type $simple-result-def))
  (func (export "flat-result") (param "value" $simple-result) (result $simple-result)
    (canon lift (core func $words-3) (memory $mem) (realloc $realloc)))
  (type $wide-tuple-def (tuple u32 u32 u32 u32 u32 u32 u32 u32 u32 u32 u32 u32 u32 u32 u32 u32 u32))
  (export $wide-tuple "wide-tuple" (type $wide-tuple-def))
  (func (export "indirect-tuple") (param "value" $wide-tuple) (result $wide-tuple)
    (canon lift (core func $scalar) (memory $mem) (realloc $realloc)))
  (export $again "again" (func 0))
  (export "again-again" (func $again))
)
