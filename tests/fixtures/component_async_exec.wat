(component
  (type $number (func async (result u32)))
  (type $text (func async (param "value" string) (result string)))
  (type $pair-result (func async (result u64)))
  (type $copy (func async (param "handle" u32) (result u32)))
  (type $stream (stream u32))
  (type $text-stream (stream string))
  (type $text-copy (func async (param "handle" u32) (result string)))
  (core func $get (canon context.get i64 0))
  (core func $set (canon context.set i64 0))
  (core instance $context (export "get" (func $get)) (export "set" (func $set)))
  (core module $memory
    (import "ctx" "get" (func $get (result i64)))
    (import "ctx" "set" (func $set (param i64)))
    (memory (export "m32") 1)
    (memory (export "m64") i64 1)
    (func $aux
      (local $i i32)
      call $get i64.eqz if else unreachable end
      i64.const 99 call $set
      i32.const 40 local.set $i
      loop $again local.get $i i32.const 1 i32.sub local.tee $i br_if $again end)
    (func (export "r32") (param i32 i32 i32 i32) (result i32) call $aux i32.const 1024)
    (func (export "r64") (param i64 i64 i64 i64) (result i64) call $aux i64.const 1024)
    (func (export "bad32") (param i32 i32 i32 i32) (result i32) call $aux unreachable)
    (func (export "bad64") (param i64 i64 i64 i64) (result i64) call $aux unreachable))
  (core instance $memory (instantiate $memory (with "ctx" (instance $context))))
  (alias core export $memory "m32" (core memory $m32))
  (alias core export $memory "m64" (core memory $m64))
  (alias core export $memory "r32" (core func $r32))
  (alias core export $memory "r64" (core func $r64))
  (core func $return (canon task.return (result u32)))
  (core func $return32 (canon task.return (result u32) (memory $m32)))
  (core func $return64 (canon task.return (result u32) (memory $m64)))
  (core func $text32 (canon task.return (result string) (memory $m32)))
  (core func $text64 (canon task.return (result string) (memory $m64)))
  (core func $pair (canon task.return (result u64)))
  (core func $yield (canon thread.yield))
  (core func $cancel (canon task.cancel))
  (core func $new (canon stream.new $stream))
  (core func $read32 (canon stream.read $stream (memory $m32)))
  (core func $write64 (canon stream.write $stream (memory $m64)))
  (core func $text-new (canon stream.new $text-stream))
  (core func $text-read (canon stream.read $text-stream (memory $m32) (realloc $r32)))
  (core func $text-write (canon stream.write $text-stream (memory $m64)))
  (core instance $builtins
    (export "return" (func $return))
    (export "return32" (func $return32)) (export "return64" (func $return64))
    (export "text32" (func $text32)) (export "text64" (func $text64))
    (export "pair" (func $pair)) (export "yield" (func $yield)) (export "cancel" (func $cancel))
    (export "get" (func $get)) (export "new" (func $new))
    (export "read32" (func $read32)) (export "write64" (func $write64))
    (export "text-new" (func $text-new)) (export "text-read" (func $text-read))
    (export "text-write" (func $text-write)))
  (core module $worker
    (import "a" "return" (func $return (param i32)))
    (import "a" "return32" (func $return32 (param i32)))
    (import "a" "return64" (func $return64 (param i32)))
    (import "a" "text32" (func $text32 (param i32 i32)))
    (import "a" "text64" (func $text64 (param i64 i64)))
    (import "a" "pair" (func $pair (param i64)))
    (import "a" "yield" (func $yield (result i32)))
    (import "a" "cancel" (func $cancel))
    (import "a" "get" (func $get (result i64)))
    (import "a" "new" (func $new (result i64)))
    (import "a" "read32" (func $read32 (param i32 i32 i32) (result i32)))
    (import "a" "write64" (func $write64 (param i32 i64 i64) (result i64)))
    (import "a" "text-new" (func $text-new (result i64)))
    (import "a" "text-read" (func $text-read (param i32 i32 i32) (result i32)))
    (import "a" "text-write" (func $text-write (param i32 i64 i64) (result i64)))
    (import "m" "m32" (memory $m32 1))
    (import "m" "m64" (memory $m64 i64 1))
    (data (memory $m64) (i64.const 128) "hello")
    (func (export "answer") i32.const 42 call $return)
    (func (export "yield") call $yield drop i32.const 43 call $return)
    (func (export "callback-entry") (result i32) i32.const 1)
    (func (export "callback") (param i32 i32 i32) (result i32)
      local.get 0 i32.const 6 i32.eq
      if call $cancel else i32.const 44 call $return end i32.const 0)
    (func (export "echo32") (param i32 i32)
      call $get i64.const 77 i64.ne if unreachable end
      local.get 0 local.get 1 call $text32)
    (func (export "echo64") (param i64 i64)
      call $get i64.const 77 i64.ne if unreachable end
      local.get 0 local.get 1 call $text64)
    (func (export "new") call $new call $pair)
    (func (export "read") (param i32)
      local.get 0 i32.const 16 i32.const 1 call $read32 drop
      i32.const 16 i32.load $m32 call $return32)
    (func (export "write") (param i32)
      i64.const 16 i32.const 45 i32.store $m64
      local.get 0 i64.const 16 i64.const 1 call $write64 drop
      i32.const 46 call $return64)
    (func (export "text-new") call $text-new call $pair)
    (func (export "text-read") (param i32)
      local.get 0 i32.const 32 i32.const 1 call $text-read drop
      i32.const 32 i32.load $m32 i32.const 36 i32.load $m32 call $text32)
    (func (export "text-write") (param i32)
      i64.const 32 i64.const 128 i64.store $m64
      i64.const 40 i64.const 5 i64.store $m64
      local.get 0 i64.const 32 i64.const 1 call $text-write drop
      i32.const 47 call $return64))
  (core instance $worker (instantiate $worker
    (with "a" (instance $builtins)) (with "m" (instance $memory))))
  (alias core export $worker "answer" (core func $answer))
  (alias core export $worker "yield" (core func $yield-entry))
  (alias core export $worker "callback-entry" (core func $entry))
  (alias core export $worker "callback" (core func $callback))
  (alias core export $worker "echo32" (core func $echo32))
  (alias core export $worker "echo64" (core func $echo64))
  (alias core export $worker "new" (core func $new-entry))
  (alias core export $worker "read" (core func $read))
  (alias core export $worker "write" (core func $write))
  (alias core export $worker "text-new" (core func $text-new-entry))
  (alias core export $worker "text-read" (core func $text-read-entry))
  (alias core export $worker "text-write" (core func $text-write-entry))
  (func (export "answer") (type $number) (canon lift (core func $answer) async))
  (func (export "yield") (type $number) (canon lift (core func $yield-entry) async))
  (func (export "callback") (type $number) (canon lift (core func $entry) async (callback $callback)))
  (func (export "echo32") (type $text) (canon lift (core func $echo32) async (memory $m32) (realloc $r32)))
  (func (export "echo64") (type $text) (canon lift (core func $echo64) async (memory $m64) (realloc $r64)))
  (func (export "new") (type $pair-result) (canon lift (core func $new-entry) async))
  (func (export "read") (type $copy) (canon lift (core func $read) async (memory $m32)))
  (func (export "write") (type $copy) (canon lift (core func $write) async (memory $m64)))
  (func (export "text-new") (type $pair-result) (canon lift (core func $text-new-entry) async))
  (func (export "text-read") (type $text-copy) (canon lift (core func $text-read-entry) async (memory $m32)))
  (func (export "text-write") (type $copy) (canon lift (core func $text-write-entry) async (memory $m64)))
)
