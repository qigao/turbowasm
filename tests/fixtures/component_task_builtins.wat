(component
  (core module $memories
    (memory (export "m32") 1)
    (memory (export "m64") i64 1))
  (core instance $m (instantiate $memories))
  (alias core export $m "m32" (core memory $m32))
  (alias core export $m "m64" (core memory $m64))
  (core func (canon task.return (result u32)))
  (core func (canon task.cancel))
  (core func (canon context.get i64 0))
  (core func (canon context.set i64 0))
  (core func (canon context.get i64 1))
  (core func (canon context.set i64 1))
  (core func (canon backpressure.inc))
  (core func (canon backpressure.dec))
  (core func (canon waitable-set.new))
  (core func (canon waitable-set.drop))
  (core func (canon waitable.join))
  (core func (canon thread.yield))
  (core func (canon waitable-set.wait (memory $m32)))
  (core func (canon waitable-set.poll (memory $m32)))
  (core func (canon waitable-set.wait (memory $m64)))
  (core func (canon waitable-set.poll (memory $m64)))
)
