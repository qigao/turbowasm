(component
  (import "wasi:sockets/network@0.2.8" (instance $network-types
    (export "network" (type $network (sub resource)))
    (type $error (enum "unknown" "access-denied" "not-supported" "invalid-argument"
      "out-of-memory" "timeout" "concurrency-conflict" "not-in-progress" "would-block"
      "invalid-state" "new-socket-limit" "address-not-bindable" "address-in-use"
      "remote-unreachable" "connection-refused" "connection-reset" "connection-aborted"
      "datagram-too-large" "name-unresolvable" "temporary-resolver-failure" "permanent-resolver-failure"))
    (export "error-code" (type (eq $error)))
    (type $family (enum "ipv4" "ipv6"))
    (export "ip-address-family" (type (eq $family)))
    (type $v4-address-raw (tuple u8 u8 u8 u8))
    (export "ipv4-address" (type $v4-address (eq $v4-address-raw)))
    (type $v6-address-raw (tuple u16 u16 u16 u16 u16 u16 u16 u16))
    (export "ipv6-address" (type $v6-address (eq $v6-address-raw)))
    (type $v4-raw (record (field "port" u16) (field "address" $v4-address)))
    (export "ipv4-socket-address" (type $v4 (eq $v4-raw)))
    (type $v6-raw (record (field "port" u16) (field "flow-info" u32)
      (field "address" $v6-address) (field "scope-id" u32)))
    (export "ipv6-socket-address" (type $v6 (eq $v6-raw)))
    (type $address (variant (case "ipv4" $v4) (case "ipv6" $v6)))
    (export "ip-socket-address" (type (eq $address)))
    (type $ip (variant (case "ipv4" $v4-address) (case "ipv6" $v6-address)))
    (export "ip-address" (type (eq $ip)))
  ))
  (alias export $network-types "network" (type $network))
  (alias export $network-types "error-code" (type $error))
  (alias export $network-types "ip-address-family" (type $family))
  (alias export $network-types "ip-socket-address" (type $address))
  (import "wasi:sockets/instance-network@0.2.8" (instance $net
    (export "instance-network" (func (result (own $network))))))
  (import "wasi:io/poll@0.2.8" (instance $poll
    (export "pollable" (type $pollable (sub resource)))
    (export "[method]pollable.block" (func (param "self" (borrow $pollable))))))
  (alias export $poll "pollable" (type $pollable))
  (import "wasi:sockets/udp@0.2.8" (instance $udp
    (export "udp-socket" (type $socket (sub resource)))
    (export "incoming-datagram-stream" (type $input (sub resource)))
    (export "outgoing-datagram-stream" (type $output (sub resource)))
    (type $incoming-raw (record (field "data" (list u8)) (field "remote-address" $address)))
    (type $outgoing-raw (record (field "data" (list u8)) (field "remote-address" (option $address))))
    (export "incoming-datagram" (type $incoming (eq $incoming-raw)))
    (export "outgoing-datagram" (type $outgoing (eq $outgoing-raw)))
    (export "[method]udp-socket.start-bind" (func (param "self" (borrow $socket)) (param "network" (borrow $network)) (param "local-address" $address) (result (result (error $error)))))
    (export "[method]udp-socket.finish-bind" (func (param "self" (borrow $socket)) (result (result (error $error)))))
    (export "[method]udp-socket.local-address" (func (param "self" (borrow $socket)) (result (result $address (error $error)))))
    (export "[method]udp-socket.stream" (func (param "self" (borrow $socket)) (param "remote-address" (option $address)) (result (result (tuple (own $input) (own $output)) (error $error)))))
    (export "[method]incoming-datagram-stream.receive" (func (param "self" (borrow $input)) (param "max-results" u64) (result (result (list $incoming) (error $error)))))
    (export "[method]incoming-datagram-stream.subscribe" (func (param "self" (borrow $input)) (result (own $pollable))))
    (export "[method]outgoing-datagram-stream.check-send" (func (param "self" (borrow $output)) (result (result u64 (error $error)))))
    (export "[method]outgoing-datagram-stream.send" (func (param "self" (borrow $output)) (param "datagrams" (list $outgoing)) (result (result u64 (error $error)))))
  ))
  (alias export $udp "udp-socket" (type $socket))
  (alias export $udp "incoming-datagram-stream" (type $input))
  (alias export $udp "outgoing-datagram-stream" (type $output))
  (import "wasi:sockets/udp-create-socket@0.2.8" (instance $create
    (export "create-udp-socket" (func (param "address-family" $family) (result (result (own $socket) (error $error)))))))
  (core module $Memory (memory (export "mem")  1))
  (core instance $memory (instantiate $Memory))
  (alias core export $memory "mem" (core memory $mem))
  (core module $Alloc
    (global $next (mut i32) (i32.const 2048))
    (func (export "realloc") (param i32 i32 i32 i32) (result i32)
      (local $p i32)
      (local.set $p (i32.and (i32.add (global.get $next) (i32.sub (local.get 2) (i32.const 1)))
        (i32.sub (i32.const 0) (local.get 2))))
      (global.set $next (i32.add (local.get $p) (local.get 3))) (local.get $p)))
  (core instance $alloc (instantiate $Alloc))
  (alias core export $alloc "realloc" (core func $realloc))
  (core func $network (canon lower (func $net "instance-network")))
  (core func $create (canon lower (func $create "create-udp-socket") (memory $mem)))
  (core func $bind (canon lower (func $udp "[method]udp-socket.start-bind") (memory $mem)))
  (core func $finish (canon lower (func $udp "[method]udp-socket.finish-bind") (memory $mem)))
  (core func $local (canon lower (func $udp "[method]udp-socket.local-address") (memory $mem)))
  (core func $stream (canon lower (func $udp "[method]udp-socket.stream") (memory $mem)))
  (core func $receive (canon lower (func $udp "[method]incoming-datagram-stream.receive") (memory $mem) (realloc $realloc)))
  (core func $subscribe (canon lower (func $udp "[method]incoming-datagram-stream.subscribe")))
  (core func $check (canon lower (func $udp "[method]outgoing-datagram-stream.check-send") (memory $mem)))
  (core func $send (canon lower (func $udp "[method]outgoing-datagram-stream.send") (memory $mem)))
  (core func $block (canon lower (func $poll "[method]pollable.block")))
  (core func $drop-network (canon resource.drop $network))
  (core func $drop-socket (canon resource.drop $socket))
  (core func $drop-input (canon resource.drop $input))
  (core func $drop-output (canon resource.drop $output))
  (core func $drop-poll (canon resource.drop $pollable))
  (core module $Client
    (import "m" "mem" (memory  1))
    (import "p" "network" (func $network (result i32)))
    (import "p" "create" (func $create (param i32 i32)))
    (import "p" "bind" (func $bind (param i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)))
    (import "p" "finish" (func $finish (param i32 i32)))
    (import "p" "local" (func $local (param i32 i32)))
    (import "p" "stream" (func $stream (param i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)))
    (import "p" "receive" (func $receive (param i32 i64 i32)))
    (import "p" "subscribe" (func $subscribe (param i32) (result i32)))
    (import "p" "check" (func $check (param i32 i32)))
    (import "p" "send" (func $send (param i32 i32 i32 i32)))
    (import "p" "block" (func $block (param i32)))
    (import "p" "drop-network" (func $drop-network (param i32)))
    (import "p" "drop-socket" (func $drop-socket (param i32)))
    (import "p" "drop-input" (func $drop-input (param i32)))
    (import "p" "drop-output" (func $drop-output (param i32)))
    (import "p" "drop-poll" (func $drop-poll (param i32)))
    (data (i32.const 1024) "hello")
    (func $ok (param $p i32) (if (i32.load8_u (local.get $p)) (then unreachable)))
    (func $new (param $n i32) (result i32)
      (local $s i32)
      (call $create (i32.const 0) (i32.const 0)) (call $ok (i32.const 0))
      (local.set $s (i32.load (i32.const 4)))
      (call $bind (local.get $s) (local.get $n) (i32.const 0) (i32.const 0)
        (i32.const 127) (i32.const 0) (i32.const 0) (i32.const 1)
        (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 16))
      (call $ok (i32.const 16)) (call $finish (local.get $s) (i32.const 16))
      (call $ok (i32.const 16)) (local.get $s))
    (func (export "run") (result i32)
      (local $n i32) (local $sender i32) (local $receiver i32) (local $port i32)
      (local $in0 i32) (local $out0 i32) (local $in1 i32) (local $out1 i32) (local $poll i32)
      (local $seen i32) (local $count i32) (local $index i32) (local $record i32)
      (local.set $n (call $network))
      (local.set $receiver (call $new (local.get $n))) (local.set $sender (call $new (local.get $n)))
      (call $local (local.get $receiver) (i32.const 32)) (call $ok (i32.const 32))
      (local.set $port (i32.load16_u (i32.const 40)))
      (call $stream (local.get $receiver) (i32.const 0) (i32.const 0) (i32.const 0)
        (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)
        (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 80))
      (call $ok (i32.const 80))
      (local.set $in0 (i32.load (i32.const 84))) (local.set $out0 (i32.load (i32.const 88)))
      (call $stream (local.get $sender) (i32.const 1) (i32.const 0) (local.get $port)
        (i32.const 127) (i32.const 0) (i32.const 0) (i32.const 1)
        (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 80))
      (call $ok (i32.const 80))
      (local.set $in1 (i32.load (i32.const 84))) (local.set $out1 (i32.load (i32.const 88)))
      ;; Two canonical outgoing records: copied payload and a real empty message.
      (i32.store (i32.const 512) (i32.const 1024))
      (i32.store (i32.const 516) (i32.const 5))
      (call $check (local.get $out1) (i32.const 128)) (call $ok (i32.const 128))
      (if (i64.lt_u (i64.load (i32.const 136)) (i64.const 2)) (then unreachable))
      (call $send (local.get $out1) (i32.const 512) (i32.const 2) (i32.const 128))
      (call $ok (i32.const 128))
      (if (i64.ne (i64.load (i32.const 136)) (i64.const 2)) (then unreachable))
      (local.set $poll (call $subscribe (local.get $in0)))
      (loop $more
        (call $block (local.get $poll))
        (call $receive (local.get $in0) (i64.const 2) (i32.const 160)) (call $ok (i32.const 160))
        (local.set $count (i32.load (i32.const 168)))
        (local.set $record (i32.load (i32.const 164))) (local.set $index (i32.const 0))
        (block $done (loop $items
          (br_if $done (i32.ge_u (local.get $index) (local.get $count)))
          (if (i32.eqz (local.get $seen))
            (then
              (if (i32.ne (i32.load offset=4 (local.get $record)) (i32.const 5)) (then unreachable))
              (if (i32.ne (i32.load8_u (i32.load (local.get $record))) (i32.const 104)) (then unreachable)))
            (else (if (i32.load offset=4 (local.get $record)) (then unreachable))))
          (if (i32.load8_u offset=8 (local.get $record)) (then unreachable))
          (if (i32.ne (i32.load8_u offset=14 (local.get $record)) (i32.const 127)) (then unreachable))
          (local.set $seen (i32.add (local.get $seen) (i32.const 1)))
          (local.set $index (i32.add (local.get $index) (i32.const 1)))
          (local.set $record (i32.add (local.get $record) (i32.const 40))) (br $items)))
        (br_if $more (i32.lt_u (local.get $seen) (i32.const 2))))
      (call $drop-poll (local.get $poll))
      (call $drop-input (local.get $in0)) (call $drop-output (local.get $out0))
      (call $drop-input (local.get $in1)) (call $drop-output (local.get $out1))
      (call $drop-socket (local.get $sender)) (call $drop-socket (local.get $receiver)) (call $drop-network (local.get $n))
      (i32.const 2)))
  (core instance $client (instantiate $Client
    (with "m" (instance $memory))
    (with "p" (instance
      (export "network" (func $network)) (export "create" (func $create))
      (export "bind" (func $bind)) (export "finish" (func $finish)) (export "local" (func $local))
      (export "stream" (func $stream)) (export "receive" (func $receive)) (export "subscribe" (func $subscribe))
      (export "check" (func $check)) (export "send" (func $send)) (export "block" (func $block))
      (export "drop-network" (func $drop-network)) (export "drop-socket" (func $drop-socket))
      (export "drop-input" (func $drop-input)) (export "drop-output" (func $drop-output)) (export "drop-poll" (func $drop-poll))
    ))))
  (func (export "run") (result u32) (canon lift (core func $client "run")))
)
