(component
  ;; A real asynchronous client: connect, wait, publish both streams, write
  ;; ping, block until pong arrives, then drop every owned carrier.
  (import "wasi:sockets/network@0.2.8" (instance $network-types
    (export "network" (type $network (sub resource)))
    (type $error (enum "unknown" "access-denied" "not-supported" "invalid-argument"
      "out-of-memory" "timeout" "concurrency-conflict" "not-in-progress" "would-block"
      "invalid-state" "new-socket-limit" "address-not-bindable" "address-in-use"
      "remote-unreachable" "connection-refused" "connection-reset" "connection-aborted"
      "datagram-too-large" "name-unresolvable" "temporary-resolver-failure" "permanent-resolver-failure"))
    (export "error-code" (type (eq $error)))
    (type $family (enum "ipv4" "ipv6"))
    (export "ip-address-family" (type (eq $family)))
    (type $v4-address-raw (tuple u8 u8 u8 u8))
    (export "ipv4-address" (type $v4-address (eq $v4-address-raw)))
    (type $v6-address-raw (tuple u16 u16 u16 u16 u16 u16 u16 u16))
    (export "ipv6-address" (type $v6-address (eq $v6-address-raw)))
    (type $v4-raw (record (field "port" u16) (field "address" $v4-address)))
    (export "ipv4-socket-address" (type $v4 (eq $v4-raw)))
    (type $v6-raw (record (field "port" u16) (field "flow-info" u32)
      (field "address" $v6-address) (field "scope-id" u32)))
    (export "ipv6-socket-address" (type $v6 (eq $v6-raw)))
    (type $address (variant (case "ipv4" $v4) (case "ipv6" $v6)))
    (export "ip-socket-address" (type (eq $address)))
  ))
  (alias export $network-types "network" (type $network))
  (alias export $network-types "error-code" (type $error))
  (alias export $network-types "ip-address-family" (type $family))
  (alias export $network-types "ip-socket-address" (type $address))
  (import "wasi:sockets/instance-network@0.2.8" (instance $net
    (export "instance-network" (func (result (own $network))))))
  (import "wasi:io/poll@0.2.8" (instance $poll
    (export "pollable" (type $pollable (sub resource)))
    (export "[method]pollable.block" (func (param "self" (borrow $pollable))))))
  (alias export $poll "pollable" (type $pollable))
  (import "wasi:io/error@0.2.8" (instance $errors
    (export "error" (type $io-error (sub resource)))))
  (alias export $errors "error" (type $io-error))
  (import "wasi:io/streams@0.2.8" (instance $streams
    (export "input-stream" (type $input (sub resource)))
    (export "output-stream" (type $output (sub resource)))
    (type $stream-error-raw (variant (case "last-operation-failed" (own $io-error)) (case "closed")))
    (export "stream-error" (type $stream-error (eq $stream-error-raw)))
    (export "[method]output-stream.check-write" (func (param "self" (borrow $output)) (result (result u64 (error $stream-error)))))
    (export "[method]output-stream.write" (func (param "self" (borrow $output)) (param "contents" (list u8)) (result (result (error $stream-error)))))
    (export "[method]input-stream.blocking-read" (func (param "self" (borrow $input)) (param "len" u64) (result (result (list u8) (error $stream-error)))))
  ))
  (alias export $streams "input-stream" (type $input))
  (alias export $streams "output-stream" (type $output))
  (import "wasi:sockets/tcp@0.2.8" (instance $tcp
    (export "tcp-socket" (type $socket (sub resource)))
    (export "[method]tcp-socket.start-connect" (func (param "self" (borrow $socket)) (param "network" (borrow $network)) (param "remote-address" $address) (result (result (error $error)))))
    (export "[method]tcp-socket.finish-connect" (func (param "self" (borrow $socket)) (result (result (tuple (own $input) (own $output)) (error $error)))))
    (export "[method]tcp-socket.subscribe" (func (param "self" (borrow $socket)) (result (own $pollable))))
  ))
  (alias export $tcp "tcp-socket" (type $socket))
  (import "wasi:sockets/tcp-create-socket@0.2.8" (instance $create
    (export "create-tcp-socket" (func (param "address-family" $family) (result (result (own $socket) (error $error)))))))

  (core module $Memory (memory (export "mem") 1))
  (core instance $memory (instantiate $Memory))
  (alias core export $memory "mem" (core memory $mem))
  (core module $Alloc
    (global $next (mut i32) (i32.const 2048))
    (func (export "realloc") (param i32 i32 i32 i32) (result i32)
      (local $p i32)
      (local.set $p (global.get $next))
      (global.set $next (i32.add (global.get $next) (local.get 3)))
      (local.get $p)))
  (core instance $alloc (instantiate $Alloc))
  (alias core export $alloc "realloc" (core func $realloc))
  (core func $network (canon lower (func $net "instance-network")))
  (core func $create (canon lower (func $create "create-tcp-socket") (memory $mem)))
  (core func $start (canon lower (func $tcp "[method]tcp-socket.start-connect") (memory $mem)))
  (core func $finish (canon lower (func $tcp "[method]tcp-socket.finish-connect") (memory $mem)))
  (core func $subscribe (canon lower (func $tcp "[method]tcp-socket.subscribe")))
  (core func $block (canon lower (func $poll "[method]pollable.block")))
  (core func $check (canon lower (func $streams "[method]output-stream.check-write") (memory $mem)))
  (core func $write (canon lower (func $streams "[method]output-stream.write") (memory $mem)))
  (core func $read (canon lower (func $streams "[method]input-stream.blocking-read") (memory $mem) (realloc $realloc)))
  (core func $drop-network (canon resource.drop $network))
  (core func $drop-socket (canon resource.drop $socket))
  (core func $drop-poll (canon resource.drop $pollable))
  (core func $drop-input (canon resource.drop $input))
  (core func $drop-output (canon resource.drop $output))
  (core module $Client
    (import "m" "mem" (memory 1))
    (import "p" "network" (func $network (result i32)))
    (import "p" "create" (func $create (param i32 i32)))
    (import "p" "start" (func $start (param i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)))
    (import "p" "finish" (func $finish (param i32 i32)))
    (import "p" "subscribe" (func $subscribe (param i32) (result i32)))
    (import "p" "block" (func $block (param i32)))
    (import "p" "check" (func $check (param i32 i32)))
    (import "p" "write" (func $write (param i32 i32 i32 i32)))
    (import "p" "read" (func $read (param i32 i64 i32)))
    (import "p" "drop-network" (func $drop-network (param i32)))
    (import "p" "drop-socket" (func $drop-socket (param i32)))
    (import "p" "drop-poll" (func $drop-poll (param i32)))
    (import "p" "drop-input" (func $drop-input (param i32)))
    (import "p" "drop-output" (func $drop-output (param i32)))
    (data (i32.const 1024) "ping")
    (func $ok (param $p i32) (if (i32.load8_u (local.get $p)) (then unreachable)))
    (func (export "run") (param $port i32) (result i32)
      (local $net i32) (local $socket i32) (local $poll i32)
      (local $input i32) (local $output i32) (local $result i32)
      (local.set $net (call $network))
      (call $create (i32.const 0) (i32.const 0))
      (call $ok (i32.const 0))
      (local.set $socket (i32.load (i32.const 4)))
      ;; IPv4 branch: discriminator, port, 127.0.0.1, then six unused join slots.
      (call $start (local.get $socket) (local.get $net) (i32.const 0) (local.get $port)
        (i32.const 127) (i32.const 0) (i32.const 0) (i32.const 1)
        (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 16))
      (call $ok (i32.const 16))
      (local.set $poll (call $subscribe (local.get $socket)))
      (call $block (local.get $poll))
      (call $finish (local.get $socket) (i32.const 32))
      (call $ok (i32.const 32))
      (local.set $input (i32.load (i32.const 36)))
      (local.set $output (i32.load (i32.const 40)))
      (call $check (local.get $output) (i32.const 64))
      (call $ok (i32.const 64))
      (if (i64.lt_u (i64.load (i32.const 72)) (i64.const 4)) (then unreachable))
      (call $write (local.get $output) (i32.const 1024) (i32.const 4) (i32.const 96))
      (call $ok (i32.const 96))
      (call $read (local.get $input) (i64.const 4) (i32.const 128))
      (call $ok (i32.const 128))
      (if (i32.ne (i32.load (i32.const 136)) (i32.const 4)) (then unreachable))
      (local.set $result (i32.load (i32.load (i32.const 132))))
      (call $drop-poll (local.get $poll))
      (call $drop-input (local.get $input))
      (call $drop-output (local.get $output))
      (call $drop-socket (local.get $socket))
      (call $drop-network (local.get $net))
      (local.get $result)))
  (core instance $client (instantiate $Client
    (with "m" (instance $memory))
    (with "p" (instance
      (export "network" (func $network)) (export "create" (func $create))
      (export "start" (func $start)) (export "finish" (func $finish))
      (export "subscribe" (func $subscribe)) (export "block" (func $block))
      (export "check" (func $check)) (export "write" (func $write)) (export "read" (func $read))
      (export "drop-network" (func $drop-network)) (export "drop-socket" (func $drop-socket))
      (export "drop-poll" (func $drop-poll)) (export "drop-input" (func $drop-input)) (export "drop-output" (func $drop-output))
    ))))
  (func (export "run") (param "port" u16) (result u32) (canon lift (core func $client "run")))
)
